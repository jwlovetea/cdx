{
  "name": "cdx",
  "displayName": "Clinical Data Explorer",
  "description": "Open SAS and XPT clinical datasets in Positron via DuckDB and Parquet.",
  "version": "0.0.2",
  "publisher": "local",
  "icon": "media/cdx.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwlovetea/cdx.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0",
    "positron": "^2026.06.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CDX runs native DuckDB and reads clinical datasets from disk; it does not start in untrusted workspaces."
    }
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "onCommand:cdx.openClinicalDataset",
    "onCommand:cdx.convertClinicalDatasetToParquet",
    "onCommand:cdx.clearCache",
    "onCommand:cdx.openCacheFolder",
    "onCommand:cdx.showLog",
    "onCustomEditor:cdx.clinicalDatasetPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cdx.openClinicalDataset",
        "title": "CDX: Open Clinical Dataset"
      },
      {
        "command": "cdx.convertClinicalDatasetToParquet",
        "title": "CDX: Convert Clinical Dataset to Parquet"
      },
      {
        "command": "cdx.clearCache",
        "title": "CDX: Clear CDX Cache"
      },
      {
        "command": "cdx.openCacheFolder",
        "title": "CDX: Open Cache Folder"
      },
      {
        "command": "cdx.showLog",
        "title": "CDX: Show Log"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cdx.openClinicalDataset",
          "when": "resourceExtname == .sas7bdat || resourceExtname == .xpt",
          "group": "navigation@10"
        },
        {
          "command": "cdx.convertClinicalDatasetToParquet",
          "when": "resourceExtname == .sas7bdat || resourceExtname == .xpt",
          "group": "navigation@11"
        }
      ],
      "commandPalette": [
        {
          "command": "cdx.openClinicalDataset"
        },
        {
          "command": "cdx.convertClinicalDatasetToParquet"
        },
        {
          "command": "cdx.clearCache"
        },
        {
          "command": "cdx.openCacheFolder"
        },
        {
          "command": "cdx.showLog"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "cdx.clinicalDatasetPreview",
        "displayName": "Clinical Data Explorer",
        "selector": [
          {
            "filenamePattern": "*.sas7bdat"
          },
          {
            "filenamePattern": "*.xpt"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const d of ['out','dist']) fs.rmSync(d, { recursive: true, force: true });\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.cjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bundle": "node esbuild.js --production",
    "vscode:prepublish": "npm run compile && npm run bundle"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@posit-dev/positron": "^0.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.14",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  }
}
